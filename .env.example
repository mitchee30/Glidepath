# Copy to .env (git ignores it). npm start loads it automatically.
# Everything is optional; without an API key photo recognition runs in demo mode.

PORT=3000
DB_PATH=./data/glidepath.db

# Photo recognition: Claude (preferred when set) or OpenAI
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_DETAIL=auto
# AI_PROVIDER=anthropic
RECOGNIZE_DAILY_LIMIT=30
# Let demo accounts use the real model too (costs money on a public site)
DEMO_USES_AI=0

# Behind a proxy such as Render: trust X-Forwarded-* for HTTPS cookies and rate limits
TRUST_PROXY=0

# Camera rep counting: where the browser gets the MediaPipe pose model (about 6 MB).
# Default is Google's hosted copy. Use POSE_MODEL_FILE to serve a local copy instead.
# POSE_MODEL_URL=
# POSE_MODEL_FILE=./models/pose_landmarker_lite.task
